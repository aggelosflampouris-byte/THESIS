<?xml version="1.0" encoding="utf-8"?>
<!--
   GDPR Art. 17 Full Backup Content Rules (Pre-API 31).
   Excludes databases and SharedPreferences from ADB backup and Google Drive sync.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
