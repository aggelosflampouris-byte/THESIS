<?xml version="1.0" encoding="utf-8"?>
<!--
   GDPR Art. 17 Data Extraction Rules (Android 12+ / API 31+).
   Strictly excludes SQLCipher encrypted databases, KeyStore envelope SharedPreferences,
   and application sandbox files from cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
